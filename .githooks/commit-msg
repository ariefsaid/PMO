#!/bin/sh
# Owner rule: no attribution trailers in commits (Co-authored-by and the like), from any actor.
if grep -qiE '^(co-authored-by|generated-by|signed-off-by:.*(claude|orca|codex|gemini|anthropic|openai))' "$1"; then
  echo "commit-msg: attribution trailers are not allowed in this repo; remove the line and commit again." >&2
  exit 1
fi
