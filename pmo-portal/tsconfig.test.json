// Unit tests and their fixtures: everything tsconfig.json checks except the app and server projects
// (read from their emitted declarations) and the files tsconfig.tooling.json owns.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "../.tsbuild/test.tsbuildinfo"
  },
  "exclude": [
    "coverage",
    "dist",
    "dist-consent",
    "node_modules",
    "e2e",
    "evals",
    "playwright.config.ts",
    "vitest.eval.config.ts",
    "vite.config.ts",
    "eslint.config.js"
  ],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.server.json"
    }
  ]
}
