// Production code of the app, checked as its own composite project so the test project (tsconfig.test.json)
// reads its declarations instead of re-checking it: two smaller programs instead of one large one.
// `exclude` defines the test side; every file it leaves out is checked by tsconfig.test.json or
// tsconfig.tooling.json instead (test/tsconfigProjects.test.ts pins that no file is dropped).
// `files` lists the files outside pmo-portal that production code imports (a composite project must list
// every file it compiles). An import of a new one fails with TS6307 until it is added here.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "rootDir": "..",
    "outDir": "../.tsbuild/app",
    "tsBuildInfoFile": "../.tsbuild/app.tsbuildinfo"
  },
  "include": [
    "**/*",
    "public/locales/**/*.json",
    "src/**/*.json"
  ],
  "files": [
    "../scripts/lib/budget-import-identity.d.mts",
