# Cloudflare Pages response headers (copied into dist/ by Vite). Proof: test/securityHeaders.test.ts.
# No page of the app may be shown inside a frame — in particular the OAuth consent screen (#728).
/*
  Content-Security-Policy: object-src 'none'; base-uri 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin
# #2705: the phone clock-in screen (/my) reads the position once, on a tap. The site-wide rule above blocks geolocation everywhere;
# this route-scoped rule detaches it and re-adds the policy with geolocation allowed for this origin only. Camera and microphone stay
# blocked. The browser API is called only from the clock-in section (src/lib/position.ts). Proof: test/phoneClockInHeaders.test.ts.
/my
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
# The check-in area form (/crews) has a "use my current location" button that reads the position once, on a tap. Same scoping as /my.
/crews
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
# Vite emits content-hashed filenames under /assets/, so a changed file always has a new URL: cache for a
# year and skip revalidation. index.html is not matched here, so it keeps revalidating and picks up new hashes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
# Service worker must revalidate immediately so updates take effect without delay
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
