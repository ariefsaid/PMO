# Cloudflare Pages response headers (copied into dist/ by Vite). Proof: test/securityHeaders.test.ts.
# No page of the app may be shown inside a frame — in particular the OAuth consent screen (#728).
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
# Vite emits content-hashed filenames under /assets/, so a changed file always has a new URL: cache for a
# year and skip revalidation. index.html is not matched here, so it keeps revalidating and picks up new hashes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
