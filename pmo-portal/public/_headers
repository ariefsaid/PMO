# Cloudflare Pages response headers (copied into dist/ by Vite). Proof: test/securityHeaders.test.ts.
# No page of the app may be shown inside a frame — in particular the OAuth consent screen (#728).
# Geolocation is allowed for this site's own origin on every route (#2705 clock-in, the crews check-in area form): a browser keeps
# the policy of the first page it loaded, so a per-route rule would not hold after in-app navigation. The browser still asks the
# person each time; the API is called only on a tap (src/lib/position.ts). Camera and microphone stay blocked. Proof: test/phoneClockInHeaders.test.ts.
/*
  Content-Security-Policy: object-src 'none'; base-uri 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
  Cross-Origin-Opener-Policy: same-origin
# Vite emits content-hashed filenames under /assets/, so a changed file always has a new URL: cache for a
# year and skip revalidation. index.html is not matched here, so it keeps revalidating and picks up new hashes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
# Service worker must revalidate immediately so updates take effect without delay
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
